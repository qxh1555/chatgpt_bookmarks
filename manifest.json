{
  "manifest_version": 3,
  "name": "对话书签 · ChatGPT",
  "version": "1.0.0",
  "description": "在 ChatGPT 长回答中标记阅读位置，随时一键返回。书签仅保存在本机。",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开对话书签" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["anchors.js", "content.js"],
    "run_at": "document_idle"
  }]
}
